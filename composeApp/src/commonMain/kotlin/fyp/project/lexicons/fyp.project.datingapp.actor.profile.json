{
  "lexicon": 1,
  "id": "fyp.project.datingapp.actor.profile",
  "description": "A user's dating profile. Each user has exactly one profile record (key: 'self').",
    "defs": {
      "main": {
        "type": "record",
        "key": "literal:self",
        "record": {
          "type": "object",
          "required": ["displayName", "createdAt"],
          "properties": {
            "displayName": {"type": "string", "maxGraphemes": 64, "maxLength": 640},
            "bio": {"type": "string", "maxGraphemes": 500, "maxLength": 5000},
            "age": {"type": "integer", "minimum": 18, "maximum": 120},
            "interests": {"type": "array", "items": {"type": "string"}, "maxLength": 20},
            "avatar": {"type": "blob", "accept": ["image/jpeg", "image/png"], "maxSize": 5000000},
            "photos": {"type": "array", "items": {"type": "blob", "accept": ["image/jpeg", "image/png"], "maxSize": 5000000}, "maxLength": 10},
            "createdAt": {"type": "string", "format": "datetime"},
            "location": {"type": "ref", "ref": "#geoLocation"}
          }
          }
        },
        "geoLocation": {
          "type": "object",
          "properties": {
            "latitude": {"type": "number"},
            "longitude": {"type": "number"},
            "city": {"type": "string"}
          }
        }
    }
}